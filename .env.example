# Copiar a .env.local y completar con los datos del proyecto Supabase
# (Project Settings → API). Solo la clave pública "anon"; nunca la service_role.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Solo para scripts locales (scripts/semilla.mjs). Nunca en el frontend ni en GitHub.
# Sin prefijo VITE_ para que Vite jamás la meta en el build.
SUPABASE_SERVICE_ROLE_KEY=
